{
  "name": "heghinekilr-bot",
  "version": "0.0.1",
  "description": "Heghine's official Discord bot. It kills her every two hours, and forces her to respawn. It also has a lot of moderation features. And also it's very silly. Heh...",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "tsx watch src/index.ts",
    "build": "tsc",
    "register:commands": "tsx src/register-commands.ts",
    "import:ban-messages": "tsx src/import-ban-messages.ts",
    "import:tyk-bans": "tsx src/import-tyk-bans.ts",
    "search:maki-bans": "tsx src/search-maki-bans.ts",
    "identify:ban-cases": "tsx src/identify-ban-cases.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "Discord",
    "bot",
    "ban",
    "banned",
    "migration",
    "user",
    "users",
    "member",
    "members"
  ],
  "author": "0a9a",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/sequelize": "^4.28.20",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sqlite3@6.0.1": true
  }
}
